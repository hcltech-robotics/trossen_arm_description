<?xml version="1.0" encoding="utf-8"?>
<robot name="wxai" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Robot Arguments -->
  <xacro:arg name="variant"                    default="base"/>        <!-- 'base', 'leader', 'follower' -->
  <xacro:arg name="arm_side"                   default=""/>            <!-- '', 'left', 'right' -->
  <xacro:arg name="prefix"                     default=""/>
  <xacro:arg name="use_world_frame"            default="false"/>       <!-- 'true', 'false' -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>        <!-- 'real', 'mock_components' -->
  <xacro:arg name="ip_address"                 default="192.168.1.2"/>
  <xacro:arg name="base_link_frame"            default="base_link"/>

  <!-- Camera Arguments -->
  <xacro:arg name="launch_camera"       default="false" />
  <xacro:arg name="camera_type"         default="realsense" />
  <xacro:arg name="camera_pos_x"        default="0.4" />
  <xacro:arg name="camera_pos_y"        default="0.0" />
  <xacro:arg name="camera_pos_z"        default="0.68" />
  <xacro:arg name="camera_pos_roll"     default="0.0" />
  <xacro:arg name="camera_pos_pitch"    default="1.57079633" />
  <xacro:arg name="camera_pos_yaw"      default="3.14159265" />
  <xacro:arg name="camera_holder_roll"  default="0.0" />
  <xacro:arg name="camera_holder_pitch" default="0.0" />
  <xacro:arg name="camera_holder_yaw"   default="0.0" />

  <xacro:if value="$(arg use_world_frame)">
    <link name="world"/>
    <joint name="fixed" type="fixed">
      <parent
        link="world"/>
      <child
        link="$(arg base_link_frame)"/>
    </joint>
  </xacro:if> <!-- use_world_frame -->

  <xacro:include filename="$(find trossen_arm_description)/urdf/macros/_wxai.urdf.xacro" />
  <xacro:include filename="$(find trossen_arm_description)/urdf/macros/_common.urdf.xacro" />

  <xacro:trossen_black/>

  <xacro:wxai
    variant="$(arg variant)"
    arm_side="$(arg arm_side)"
    prefix="$(arg prefix)"
    ros2_control_hardware_type="$(arg ros2_control_hardware_type)"
    ip_address="$(arg ip_address)"/>

  <!-- Include the camera holder macro -->
  <xacro:if value="$(eval launch_camera)">
      <xacro:include filename="$(find trossen_arm_description)/urdf/macros/camera_with_stand.xacro"/>
      <xacro:camera_with_stand camera_pos_z="$(arg camera_pos_z)" 
                                camera_roll="$(arg camera_pos_roll)" camera_pitch="$(arg camera_pos_pitch)" camera_yaw="$(arg camera_pos_yaw)" 
                                camera_type="$(arg camera_type)" />

      <!-- Connect the overhead camera stand to the robot base. Its links/frames use the
           'overhead_camera' prefix so they can coexist with the follower variant's wrist
           D405 ('<prefix>camera_*'). They are not arm-prefixed: there is one stand per scene. -->
      <joint name="$(arg prefix)base_link_overhead_camera_mount_joint" type="fixed">
          <parent link="$(arg prefix)base_link"/>
          <child link="overhead_camera_mount_link"/>
          <origin xyz="$(arg camera_pos_x) $(arg camera_pos_y) $(arg camera_pos_z)" 
                  rpy="$(arg camera_holder_roll) $(arg camera_holder_pitch) $(arg camera_holder_yaw)"/>
      </joint>
  </xacro:if>

</robot>
